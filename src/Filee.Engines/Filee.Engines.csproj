<!--
  Filee.Engines (Lite): IConverter implementations for pictures (Skia) and PDF (PDFsharp, PDFium).
  Register new engines in EngineRegistry.cs.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Filee.Engines</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filee.Core\Filee.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Filee" />
    <InternalsVisibleTo Include="Filee.Engines.Tests" />
  </ItemGroup>
</Project>
